    {
      "id": 930000000002,
      "plugin": "Cardinal",
      "model": "TextEditor",
      "version": "2.0",
      "params": [],
      "data": {
        "filepath": "",
        "lang": "None",
        "etext": "MODULAR-SYNTH / FIRST ORIGINAL MODULE\nMORPH VCO PERFORMANCE PATCH\n\nLoad in Cardinal Synth or Main.\nPlay MIDI notes: Host MIDI pitch controls\nMorph VCO at 1V/oct, gate opens ADSR.\nADSR shapes the VCA; output to stereo host.\n\nMORPH: sine -> saw -> pulse.\nPULSE WIDTH: pulse duty. FM DEPTH: optional.\nHost gain and VCA are deliberately reduced.\nIf you hear sustained tones, stop playback\nand inspect MIDI gate connections.\n\nUses pinned bundled Fundamental ADSR/VCA.\n",
        "width": 27
      },
      "pos": [
        46,
        0
      ]
    }
